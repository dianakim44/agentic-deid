# ─── DUA 대상: 절대 커밋 금지 ───────────────────────────────
# 'data/' 가 아니라 'data/*' 다. 디렉토리를 통째로 무시하면 git 이 그 안으로
# 내려가지 않아서 아래 !예외가 동작하지 않는다.
data/*
!data/README.md
!data/acquire/
data/acquire/*
!data/acquire/*.sh
**/data/source/
**/data/derived/

# ─── 봉인된 test fold ───────────────────────────────────────
sealed/
*value_map*
*surrogate_registry*
*ko_tagged*
*ko_surrogate*
**/critic_log.jsonl
**/*_raw_llm*.jsonl
**/*_predictions_with_text*

# ─── 모델·체크포인트 ────────────────────────────────────────
*.ckpt
*.safetensors
*.bin
runs/
checkpoints/
wandb/

# ─── 환경·캐시 ──────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.cache/
.huggingface/
.pytest_cache/

# ─── OS·에디터 ──────────────────────────────────────────────
.DS_Store
Thumbs.db
~$*
.vscode/
.idea/
